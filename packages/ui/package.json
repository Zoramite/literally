{
  "name": "@littoral/ui",
  "version": "1.0.0",
  "description": "Lit-based UI components and responsive layout primitives for littoral applications.",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "docs:components": "cem analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.test.ts\" --exclude \"src/**/*.stories.ts\" && node ../literally/bin/generate-components-doc.mjs"
  },
  "keywords": [
    "lit",
    "ui",
    "web-components"
  ],
  "homepage": "https://github.com/Zoramite/literally#readme",
  "bugs": {
    "url": "https://github.com/Zoramite/literally/issues"
  },
  "license": "MIT",
  "author": "Randy Merrill <Zoramite+github@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoramite/literally.git"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@littoral/literally": "^3.9.0 || ^4.0.0",
    "lit": "^3.3.3"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json",
    "COMPONENTS.md",
    "README.md",
    "CHANGELOG.md"
  ]
}
