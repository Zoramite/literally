{
  "name": "@littoral/literally-firebase",
  "version": "0.4.0",
  "description": "Firebase utilities and integration for littoral components.",
  "exports": {
    "./firestore": {
      "types": "./dist/firestore/index.d.ts",
      "import": "./dist/firestore/index.js",
      "default": "./dist/firestore/index.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "docs:components": "cem analyze --litelement --globs \"src/**/*.ts\" --exclude \"src/**/*.test.ts\" --exclude \"src/**/*.stories.ts\" && node ../literally/bin/generate-components-doc.mjs"
  },
  "keywords": [
    "lit",
    "firebase"
  ],
  "homepage": "https://github.com/Zoramite/literally#readme",
  "bugs": {
    "url": "https://github.com/Zoramite/literally/issues"
  },
  "license": "MIT",
  "author": "Randy Merrill <Zoramite+github@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zoramite/literally.git"
  },
  "dependencies": {},
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@littoral/literally": "^3.1.0",
    "lit": "^3.3.3",
    "firebase": "^12.18.0"
  },
  "customElements": "custom-elements.json",
  "files": [
    "dist",
    "custom-elements.json",
    "README.md",
    "CHANGELOG.md",
    "ROADMAP.md"
  ]
}
