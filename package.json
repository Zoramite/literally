{
  "name": "literally-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc --build",
    "build:storybook": "storybook build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "test": "npx vitest",
    "test:ci": "npx vitest run --mode test",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "docs:components": "npm run docs:components --workspaces --if-present"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@lit/context": "^1.1.6",
    "@open-wc/testing": "^5.0.0",
    "@storybook/web-components": "^10.5.10",
    "@storybook/web-components-vite": "^10.5.10",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "lit": "^3.3.3",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "storybook": "^10.5.10",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "customElements": "custom-elements.json"
}
